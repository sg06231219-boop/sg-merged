# ══════════════════════════════════════════════════
# SG智能建站 — 环境变量模板 v9.0
# 复制为 .env 并填写实际值
# ══════════════════════════════════════════════════

# ── 应用配置 ──────────────────────────────────
# 运行环境: development | staging | production
APP_ENVIRONMENT=development
APP_VERSION=9.0.0
APP_PORT=10000
APP_DEBUG=false
APP_SITE_DOMAIN=your-domain.com

# ── 数据库（二选一）────────────────────────────
# PostgreSQL（生产环境，推荐）
DATABASE_URL=postgresql://user:password@localhost:5432/sg_builder
# SQLite（开发环境，留空自动使用）
# DATABASE_URL=

# ── Redis（企业级缓存+限流）────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# ── 安全 ──────────────────────────────────────
# 管理员初始密码（首次启动创建超管账号）
ADMIN_PASSWORD=your_secure_password_here
# JWT签名密钥（留空自动生成，多实例部署时必须设置）
JWT_SECRET=
# JWT过期时间（小时）
SECURITY_JWT_EXPIRE_HOURS=72
# CORS白名单（逗号分隔）
SECURITY_CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# ── 限流配置 ──────────────────────────────────
RATELIMIT_ENABLED=true
# 限流后端: memory | redis
RATELIMIT_BACKEND=memory
RATELIMIT_GENERATE_PER_MINUTE=10
RATELIMIT_ANON_DAILY_LIMIT=3

# ── 缓存配置 ──────────────────────────────────
CACHE_ENABLED=true
# 缓存后端: memory | redis
CACHE_BACKEND=memory
CACHE_MAX_ENTRIES=200
CACHE_TTL_SECONDS=3600

# ── 可观测性 ──────────────────────────────────
OBS_LOG_LEVEL=INFO
# 日志格式: json | text
OBS_LOG_FORMAT=json
# 日志文件（留空仅控制台输出）
OBS_LOG_FILE=
OBS_METRICS_ENABLED=true

# ── AI 后端 ──────────────────────────────────
AI_DEFAULT_BACKEND=auto
# DeepSeek API（优先使用）
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 智谱 GLM API（备用）
AI_GLM_API_KEY=
AI_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ── 支付 ──────────────────────────────────────
# 虎皮椒支付（微信/支付宝个人收款）
XUNHU_APP_ID=
XUNHU_APP_SECRET=
# Stripe（国际信用卡支付）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 商城配置密钥
SHOP_SETUP_KEY=

# ── OAuth 社交登录（可选）──────────────────────
# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
